# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres. Matches docker-compose.yml out of the box - `docker
# compose up -d` and these credentials just work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/piqnex?schema=public"

PORT=4000

# Used to sign JWTs in the Auth module - generate a real random string for
# anything beyond local development, e.g.: openssl rand -hex 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Origin the Next.js frontend runs on (piqnex-frontend's `npm run dev`), used for CORS.
FRONTEND_ORIGIN="http://localhost:3000"
