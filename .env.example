# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres. Matches docker-compose.yml out of the box - `docker
# compose up -d` and these credentials just work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/piqnex?schema=public"

PORT=4000

# Used to sign JWTs in the Auth module - generate a real random string for
# anything beyond local development, e.g.: openssl rand -hex 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Origin the Next.js frontend runs on (piqnex-frontend's `npm run dev`), used for CORS.
FRONTEND_ORIGIN="http://localhost:3000"

# ---- Email (optional) ----
# Leave MAIL_PROVIDER unset in development: emails are printed in the
# backend log instead of being sent.
#
# Option A - any SMTP server (Gmail app password, Zoho, Brevo, Amazon SES...):
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Piqnex <your-address@gmail.com>"
#
# Option B - Resend API:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="Piqnex <no-reply@your-domain.com>"
