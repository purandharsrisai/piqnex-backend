        {
          "name": "Create listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            },
            "description": "Requires {{accessToken}} (log in first). condition must be one of: New, Like New, Used - Working, Used - Good, Used - Fair, For Parts. Saves the new id as {{listingId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brandName\": \"Sony\",\n  \"productName\": \"WF-1000XM4\",\n  \"modelLabel\": \"\",\n  \"partName\": \"Right Earbud\",\n  \"condition\": \"Used - Good\",\n  \"price\": 1500,\n  \"currency\": \"INR\",\n  \"description\": \"Right earbud only, works fine, minor scuffs.\",\n  \"location\": \"Bengaluru, KA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
