  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Nest's default hello-world root route - good for a quick 'is the server up' check.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Creates a new user and returns {accessToken, user}. The test script below automatically saves accessToken as a collection variable so every other request can use it.\n\nphone is now REQUIRED at signup (loosely validated - digits, spaces, +, (), - ; 6-20 chars). It can still be changed later from Profile > Update my profile, where it remains optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"displayName\": \"Test User\",\n  \"phone\": \"{{testPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "        pm.collectionVariables.set(\"accessToken_isAdmin\", String(!!(data.user && data.user.isAdmin)));",
                  "        console.log(\"Saved accessToken for\", data.user && data.user.email);",
                  "    }",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set(\"userId\", data.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in an existing user. Also saves accessToken automatically. Re-run this after changing is_admin in the DB to pick up a token with the fresh isAdmin claim.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "        pm.collectionVariables.set(\"accessToken_isAdmin\", String(!!(data.user && data.user.isAdmin)));",
                  "        console.log(\"Saved accessToken for\", data.user && data.user.email);",
                  "    }",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set(\"userId\", data.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Starts a password reset for the given email, for a user who is logged out and has forgotten their password (separate from 'Change password', which needs to be logged in and know your current password).\n\nTEMPORARY: there's no email sending set up in this project yet, so instead of being emailed, the reset token is returned directly in this response as `resetToken` (only when the email matches a real account - otherwise just a generic message, no resetToken). The test script below saves it as the `resetToken` collection variable automatically, and the response is always 200 either way so you can't tell from the status code alone whether the email exists.\n\nWhen real email sending is added later, this response will stop including resetToken and the reset link will only go to the user's inbox instead.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.resetToken) {",
                  "        pm.collectionVariables.set(\"resetToken\", data.resetToken);",
                  "        console.log(\"Saved resetToken - run 'Reset password' next.\");",
                  "    } else {",
                  "        console.log(\"No resetToken in the response - double check testEmail matches a real account.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Finishes the 'forgot password' flow, using the {{resetToken}} saved by 'Forgot password' above. Returns 400 if the token is wrong, already used, or has expired (tokens are valid for 1 hour and can only be used once).\n\nOn success, the test script swaps {{testPassword}} and {{testNewPassword}} the same way 'Change password' does, so the saved login details stay usable for the next run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{testNewPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const oldPassword = pm.collectionVariables.get(\"testPassword\");",
                  "    const newPassword = pm.collectionVariables.get(\"testNewPassword\");",
                  "    pm.collectionVariables.set(\"testPassword\", newPassword);",
                  "    pm.collectionVariables.set(\"testNewPassword\", oldPassword);",
                  "    pm.collectionVariables.set(\"resetToken\", \"\");",
                  "    console.log(\"Password reset - testPassword/testNewPassword swapped, resetToken cleared.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (/auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns the decoded JWT payload (id, email, isAdmin) for whichever token is in {{accessToken}}."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Changes the signed-in user's password. Requires the CURRENT password (not just a valid token) - returns 401 if it's wrong, or 409 if the new password is the same as the old one. There's no 'forgot password' / email-reset flow yet (that's a separate, later piece of work) - this only covers a logged-in user who remembers their current password but wants to change it.\n\nThe test script below swaps {{testPassword}} and {{testNewPassword}} on success, so you can run this request repeatedly (e.g. re-run the whole collection) without the saved credentials going stale.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{testPassword}}\",\n  \"newPassword\": \"{{testNewPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const oldPassword = pm.collectionVariables.get(\"testPassword\");",
                  "    const newPassword = pm.collectionVariables.get(\"testNewPassword\");",
                  "    pm.collectionVariables.set(\"testPassword\", newPassword);",
                  "    pm.collectionVariables.set(\"testNewPassword\", oldPassword);",
                  "    console.log(\"Password changed - testPassword/testNewPassword swapped so the next run still works.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Stateless JWT - this is just a consistent endpoint; it doesn't invalidate the token."
          }
        }
      ]
    },
