  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Dedicated login endpoint for the separate Admin Dashboard app (piqnex-admin) - completely independent of POST /auth/login, per the \"Admin Dashboard is a separate website\" requirement. Rejects a non-admin account with the same generic \"Invalid email or password\" error used for a wrong password, so it never reveals which accounts exist or which ones are admins. On success, saves accessToken the same way \"Log in\" does, so the rest of the Admin folder keeps working against it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "        pm.collectionVariables.set(\"accessToken_isAdmin\", String(!!(data.user && data.user.isAdmin)));",
                  "        console.log(\"Saved admin accessToken for\", data.user && data.user.email);",
                  "    }",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set(\"userId\", data.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
