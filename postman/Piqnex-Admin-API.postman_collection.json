            },
            "description": "Suspends or reactivates an account. Body: `{ \"status\": \"suspended\" }` or `{ \"status\": \"active\" }`. A suspended user can't log in (403 from `POST /auth/login`, generic 401 from the admin login) and any token they already hold stops working on the next request. You can't suspend your own account (400). Admin only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send password reset email (admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{targetUserId}}/password-reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "{{targetUserId}}",
                "password-reset"
              ]
            },
            "description": "Emails the user a normal password reset link (same token, 1-hour expiry and single-use rules as `POST /auth/forgot-password`). The link is NEVER returned to the admin - only `{ email, delivered }`, where `delivered` is false when no mail provider is configured (the link is then printed in the backend console in dev). 404 if the user doesn't exist. Admin only (403 for a Moderator). Set the `targetUserId` collection variable first."
          }
        }
